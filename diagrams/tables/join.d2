vars: {
  d2-config: {
    sketch: true
  }
}
shape: sequence_diagram

Host: User
Router: tableRouter
Ctrl: TableController
TDAO: TableDAO
PDAO: TablePlayersDAO
UDAO: UserDAO
LDAO: BalanceLogDAO
IO: Socket service
GS: GameService
Players: Players

Host.a -> Router.a: Join table
Router.a -> Ctrl.a: joinTable()
Ctrl.a -> TDAO.a: getTable(id)
TDAO.a -> Ctrl.a: table + seats
Ctrl.a -> Host.a: 404 / 409 (if rejected)
Ctrl.a -> UDAO.a: getBalance()
UDAO.a -> Ctrl.a: balance
Ctrl.a -> Host.a: 409 (if rejected)
Ctrl.a -> PDAO.a: addPlayer()
PDAO.a -> Ctrl.a: done
Ctrl.a -> UDAO.b: setBalance(balance - buyIn)
UDAO.b -> Ctrl.a: done
Ctrl.a -> LDAO.a: logBalanceChange(buy_in)
LDAO.a -> Ctrl.a: done
Ctrl.a -> IO.a: broadcastChange(id)
Ctrl.a -> GS.a: startIfReady(id)
GS.a -> Ctrl.a: player ids (if 2+ seated)
Ctrl.a -> IO.b: sendViews(id, ids)
IO.b -> Players.a: 'emit "view"'
Ctrl.a -> Host.a: 204

*.style.font-size: 30
(** -> **)[*].style.font-size: 26
Host.shape: person
Players.shape: person
